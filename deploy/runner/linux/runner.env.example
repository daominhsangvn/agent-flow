# AgentFlow headless runner configuration (docs/runner.md).
# systemd reads this file; values are not quoted and not shell-expanded.

# AgentFlow API origin (https; plain http only for localhost or hosts listed
# in AGENTFLOW_ALLOW_HTTP_HOSTS).
AGENTFLOW_API_URL=https://agentflow.example.com
# Settings -> API Keys in AgentFlow. The runner registers as this key's owner.
AGENTFLOW_API_KEY=sk_live_replace_me
# Compute target name shown in AgentFlow.
AGENTFLOW_RUNNER_NAME=ubuntu-runner-1

# Claude credentials: uncomment exactly one option.
# Subscription token from `claude setup-token`:
#CLAUDE_CODE_OAUTH_TOKEN=
# Claude Console API key:
#ANTHROPIC_API_KEY=
# Anthropic-compatible gateway or proxy:
#ANTHROPIC_BASE_URL=
#ANTHROPIC_AUTH_TOKEN=

# GitHub token for clone, push and pull requests (bot account recommended).
#GH_TOKEN=
#GIT_AUTHOR_NAME=AgentFlow Runner
#GIT_AUTHOR_EMAIL=runner@example.com

#AGENTFLOW_RUNNER_MAX_CONCURRENT=2
#AGENTFLOW_ALLOW_HTTP_HOSTS=

# Keeps Claude Code on the version set in AgentFlow (Model provider → Claude
# Code version) instead of updating itself.
DISABLE_AUTOUPDATER=1
