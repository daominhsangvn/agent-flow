# Copy to `.env` (next to docker-compose.yml) to override the defaults.
# Host ports — change them if something else already listens on these.
POSTGRES_PORT=5432
S3_PORT=9000
S3_CONSOLE_PORT=9001
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
LOCAL_GIT_PORT=3300
# Local Git as browsers reach it (page and clone links); match LOCAL_GIT_PORT.
LOCAL_GIT_URL=http://localhost:3300

POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=agentflow_ai

# RustFS root credentials; apps use the same pair as S3_ACCESS_KEY_ID /
# S3_SECRET_ACCESS_KEY. Change both for anything beyond local development.
S3_ACCESS_KEY_ID=agentflow
S3_SECRET_ACCESS_KEY=agentflow-dev-secret
