{
  "name": "agentflow-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "pnpm --filter @repo/database db:generate",
    "build": "turbo build",
    "predev": "node scripts/predev.mjs",
    "dev": "turbo dev",
    "typecheck": "turbo typecheck",
    "figma:typecheck": "pnpm --filter @agentflow-ai/design-system figma:typecheck",
    "lint": "biome check --no-errors-on-unmatched ./",
    "lint:fix": "biome check --write --no-errors-on-unmatched ./",
    "test": "turbo test",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:ui": "playwright test --ui",
    "desktop:prebuild": "pnpm -C apps/desktop prebuild",
    "desktop:lint": "pnpm -C apps/desktop lint",
    "desktop:typecheck": "pnpm turbo typecheck --filter=desktop",
    "desktop:test": "pnpm turbo test --filter=desktop",
    "desktop:build": "pnpm -C apps/desktop build",
    "desktop:stage": "pnpm -C apps/desktop stage:package",
    "desktop:dev": "cd apps/desktop && pnpm run dev",
    "desktop:start": "cd apps/desktop && pnpm run start",
    "desktop:no-auth:start": "cd apps/desktop && AF_LOCAL_GATEWAY_NO_AUTH=1 pnpm run start",
    "desktop:package": "pnpm -C apps/desktop package",
    "desktop:debug-auth": "cd apps/desktop && AF_LOCAL_GATEWAY_DEBUG_AUTH=1 pnpm run dev",
    "desktop:no-auth": "cd apps/desktop && AF_LOCAL_GATEWAY_NO_AUTH=1 pnpm run dev:static",
    "desktop:prod-origins": "cd apps/desktop && AF_LOCAL_GATEWAY_PROD_ORIGINS_ONLY=1 pnpm run dev",
    "analyze": "turbo analyze",
    "translate": "turbo translate",
    "boundaries": "turbo boundaries",
    "bump-deps": "npx npm-check-updates --deep -u -x recharts && pnpm install",
    "bump-ui": "npx shadcn@latest add --all --overwrite -c packages/design-system",
    "migrate": "cd packages/database && pnpm prisma migrate dev",
    "migrate:status": "cd packages/database && pnpm prisma migrate status",
    "clean": "git clean -xdf node_modules",
    "prepare": "husky",
    "start-apps": "turbo dev",
    "check-deps": "npx check-dependency-version-consistency",
    "storage:init": "node scripts/storage-init.mjs",
    "local-git:init": "node scripts/local-git-init.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@playwright/test": "^1.60.0",
    "@repo/typescript-config": "workspace:*",
    "@turbo/gen": "^2.10.8",
    "@types/node": "^25.9.1",
    "check-dependency-version-consistency": "^6.0.0",
    "dotenv": "^17.4.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2",
    "next": "catalog:",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "turbo": "^2.10.8",
    "typescript": "^7.0.2",
    "typescript6": "npm:@typescript/typescript6@6.0.2",
    "ultracite": "7.1.1",
    "vitest": "^4.1.9",
    "zod": "^4.3.6"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.7.0+sha512.19cc852c120c7125760f2443ee6be0ca5b40f9f50598de1a09a1f177503e010e57c23c77646e01e761de59bf874fb22a3398c33ab9691fc13eb946b6f0f4d620",
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "commander": "^14.0.3"
  },
  "type": "module"
}
