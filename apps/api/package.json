{
  "name": "api",
  "private": true,
  "scripts": {
    "dev": "npm run server:dev",
    "server:dev": "cross-env NODE_ENV=development tsx watch server.ts",
    "server:start": "cross-env NODE_ENV=production tsx server.ts",
    "next": "next dev -p 3002",
    "build": "next build && npm run server:import-smoke",
    "start": "npm run server:start",
    "server:import-smoke": "tsx scripts/smoke-desktop-gateway-import.ts",
    "backfill:transcript-search": "tsx scripts/backfill-transcript-search.ts",
    "analyze": "cross-env ANALYZE=true npm run build",
    "test": "cross-env NODE_ENV=test vitest run",
    "test:coverage": "cross-env NODE_ENV=test vitest run --coverage --coverage.reporter=json --coverage.reporter=json-summary --coverage.reportOnFailure '--coverage.include=app/**/*.{ts,tsx}' '--coverage.include=lib/**/*.{ts,tsx}' '--coverage.include=*.{ts,tsx}'",
    "test:compatibility": "cross-env NODE_ENV=test vitest run --config vitest.config.compatibility.mts",
    "test:integration": "cross-env NODE_ENV=test vitest run --config vitest.config.integration.mts --no-file-parallelism",
    "clean": "git clean -xdf .cache .turbo dist *.tsbuildinfo node_modules",
    "typecheck": "next typegen && tsc --noEmit --emitDeclarationOnly false --incremental --tsBuildInfoFile ./tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.985.0",
    "@aws-sdk/s3-request-presigner": "^3.987.0",
    "@agentflow-ai/loops-api": "workspace:*",
    "@paralleldrive/cuid2": "^2.3.1",
    "@prisma/client": "~7.8.0",
    "@repo/ai": "workspace:*",
    "@repo/analytics": "workspace:*",
    "@repo/api": "workspace:*",
    "@repo/auth": "workspace:*",
    "@repo/collaboration": "workspace:*",
    "@repo/database": "workspace:*",
    "@repo/design-system": "workspace:@agentflow-ai/design-system@*",
    "@repo/email": "workspace:*",
    "@repo/github": "workspace:*",
    "@repo/google": "workspace:*",
    "@repo/lib": "workspace:*",
    "@repo/linear": "workspace:*",
    "@repo/next-config": "workspace:*",
    "@repo/observability": "workspace:*",
    "@repo/pensero": "workspace:*",
    "@repo/storage": "workspace:*",
    "@t3-oss/env-nextjs": "^0.13.11",
    "adm-zip": "^0.5.16",
    "better-auth": "1.7.6",
    "cross-env": "10.1.0",
    "import-in-the-middle": "^3.0.1",
    "jose": "^5.2.1",
    "marked": "17.0.6",
    "nanoid": "^5.1.6",
    "next": "catalog:",
    "node-html-markdown": "2.0.0",
    "nodemailer": "^10.0.10",
    "p-limit": "^7.3.0",
    "pg": "^8.20.0",
    "prisma": "~7.8.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "require-in-the-middle": "8.0.1",
    "sanitize-html": "^2.17.4",
    "socket.io": "^4.8.1",
    "svix": "^1.96.1",
    "tsx": "^4.21.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@octokit/webhooks-types": "^7.6.1",
    "@repo/typescript-config": "workspace:*",
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^25.9.1",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "^5.1.3",
    "dotenv": "^17.4.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript6": "npm:@typescript/typescript6@6.0.2",
    "uuid": "^14.0.0",
    "vitest": "^4.1.9",
    "yaml": ">=2.8.3"
  }
}
