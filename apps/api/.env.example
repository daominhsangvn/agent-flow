# Server

# RESEND_FROM=""
DATABASE_URL="postgresql://postgres:password@localhost:5432/agentflow_ai"
# RESEND_TOKEN=""
# SVIX_TOKEN=""
# LIVEBLOCKS_SECRET=""
VERCEL_PROJECT_PRODUCTION_URL="http://localhost:3002"
INTERNAL_API_SECRET="change-me-in-production"
# MCP endpoint runners hand to instruction agents for integration tools
# (default http://localhost:3010/mcp).
# AGENTFLOW_MCP_URL="http://localhost:3010/mcp"

# Authentication (Better Auth, served at /api/auth and proxied by the web app).
# BETTER_AUTH_URL is the public web app origin (cookies, links, JWT issuer).
# Generate a secret: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
# BETTER_AUTH_TRUSTED_ORIGINS=""          # extra origins, comma-separated
# AUTH_ALLOW_SIGN_UP="false"              # invite-only
# AUTH_AUTO_JOIN_DEFAULT_ORGANIZATION="false"
# AUTH_ALLOW_CREATE_ORGANIZATION="true"   # allow more than one organization
# AUTH_DEFAULT_ORGANIZATION_NAME="AgentFlow"
# AUTH_DEFAULT_ORGANIZATION_SLUG="agentflow"

# Outgoing mail for invitations and password resets (Mailpit in development).
SMTP_URL="smtp://localhost:1025"
EMAIL_FROM="AgentFlow <no-reply@localhost>"

# GitHub App Integration
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY=""
GITHUB_APP_WEBHOOK_SECRET=""
GITHUB_APP_CLIENT_ID=""
# owner/repo of the GitHub App installation used for app-authenticated reads
# (e.g. Desktop release lookup). Not a workflow-dispatch target.
GITHUB_APP_DISPATCH_REPO="agentflow-ai/symphony-alpha"
GITHUB_APP_CLIENT_SECRET=""
WEBAPP_ENV="stage"

# Object storage — any S3-compatible server (RustFS from docker-compose.yml).
# S3_ENDPOINT is used by the API; S3_PUBLIC_ENDPOINT is baked into presigned
# URLs and must be reachable from browsers and the desktop app.
S3_ENDPOINT="http://localhost:9000"
S3_PUBLIC_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="agentflow"
S3_SECRET_ACCESS_KEY="agentflow-dev-secret"
S3_FORCE_PATH_STYLE="true"
# Web app origins `pnpm storage:init` allows on the browser-facing buckets
# (attachment uploads, transcript reads); default: NEXT_PUBLIC_APP_URL's origin.
# S3_CORS_ALLOWED_ORIGINS="http://localhost:3000"
# S3_COLD_STORAGE_CLASS=""            # only if your backend supports it
# S3_MULTIPART_CHECKSUM="computed"    # "native" only for AWS S3
FILE_ATTACHMENTS_BUCKET="agentflow-attachments"
TRANSCRIPTS_BUCKET="agentflow-transcripts"
PLUGIN_STORE_BUCKET="agentflow-plugin-store"
LOOP_STATE_BUCKET="agentflow-loop-state"

# Secrets at rest (Claude API keys, integration tokens): AES-256-GCM master key.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""

# Client
# NEXT_PUBLIC_GA_MEASUREMENT_ID="G-..."
# NEXT_PUBLIC_POSTHOG_KEY="phc_..."
# NEXT_PUBLIC_POSTHOG_HOST=""
NEXT_PUBLIC_DOCS_URL="http://localhost:3004"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WEB_URL="http://localhost:3001"
# Cron authentication. The API process calls its own /cron/workflows and
# /cron/timeout-loops routes on a schedule (lib/self-hosted-cron.ts, started by
# server.ts). Left empty, an ephemeral secret is generated for the process; set
# it when an external scheduler calls the /cron/* routes.
CRON_SECRET=""
# SELF_HOSTED_CRON_DISABLED="true"       # turn the in-process scheduler off
# WORKFLOW_TICK_SECONDS="10"             # workflow scheduler tick (minimum 5)
# WORKFLOW_RUN_PHASE_TIMEOUT_HOURS="24"  # fail workflow runs stuck in planning/executing

# Workflows: public origin of this API used in integration inbound webhook URLs
# ({base}/webhooks/integrations/{key}). Jira Cloud and Azure DevOps must reach it
# over public HTTPS. Defaults to NEXT_PUBLIC_API_URL.
# PUBLIC_WEBHOOK_BASE_URL="https://api.example.com"

# Local Git (docker-compose `local-git`, Gitea): with a token, every
# organization gets the "Local Git" connection without adding it in Settings.
# `pnpm local-git:init` creates the token and writes these lines.
# LOCAL_GIT_SERVER_URL="http://localhost:3300"           # where this API reaches it
# LOCAL_GIT_RUNNER_URL="http://host.docker.internal:3300" # where runners reach it (empty: server URL)
# LOCAL_GIT_TOKEN=""                                      # access token of its agentflow account
# LOCAL_GIT_OWNER=""                                      # organization of new repositories (empty: the account)

# Loop runtime (Loops V2). Loops always run on a desktop compute target.
AGENTFLOW_RUNNER_JWT_SECRET=""
API_BASE_URL=""
